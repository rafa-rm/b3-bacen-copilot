# Docker / Airflow 3 user mapping (prevents root-owned logs on Linux)
AIRFLOW_UID=1000

# Airflow 3 secrets (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))")
AIRFLOW_CORE_FERNET_KEY=replace_with_fernet_key
AIRFLOW_API_SECRET_KEY=replace_with_random_secret
AIRFLOW_API_AUTH_JWT_SECRET=replace_with_jwt_secret

# PostgreSQL 18 Warehouse (shared by Docker Compose, Airflow, and agent_copom.py)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=airflow

# dbt Core profile password (must match POSTGRES_PASSWORD above)
DBT_ENV_SECRET_POSTGRES_PASSWORD=change_me_strong_password